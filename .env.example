# Environment Configuration for HR Virtual Office (HRVO)
NODE_ENV=development
PORT=3001

# PostgreSQL Configuration
# DATABASE_URL / PG*: the app connects as non-owner hrvo_app (RLS enforced).
# DIRECT_DATABASE_URL: schema owner, used only by Prisma Migrate and db:provision-roles.
# PGPASSWORD / PGRETENTION_PASSWORD are applied to the roles by `npm run db:provision-roles`.
DATABASE_URL=postgresql://hrvo_app:hrvo_app_pass@localhost:5433/hrvo_dev?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hrvo_dev?schema=public
PGHOST=localhost
PGPORT=5433
PGDATABASE=hrvo_dev
PGUSER=hrvo_app
PGPASSWORD=hrvo_app_pass
PGADMIN_USER=postgres
PGADMIN_PASSWORD=postgres
PGRETENTION_USER=hrvo_retention
PGRETENTION_PASSWORD=hrvo_retention_dev

# JWT & Authentication Secrets
# Access tokens: 15 min; refresh tokens: opaque, rotating, 7 days (FR-AUTH-003, not configurable).
# Production refuses to start with this placeholder or anything shorter than 32 chars.
JWT_SECRET=super-secret-jwt-access-key-change-in-production-min-32-chars

# HTTP / WebSocket security (ADR 005)
# Comma-separated exact origins allowed for CORS and WebSocket handshakes. Required in production.
CORS_ORIGINS=http://localhost:3000
# Set when behind a load balancer so rate limits see the client IP (Express "trust proxy" value).
TRUST_PROXY=
# ADR 019: set to cloudflare ONLY when the API is reachable solely through Cloudflare; then CF-Connecting-IP
# and CF-IPCountry are trusted for the network policy (FR-ATT-018). Otherwise they are ignored.
TRUST_PROXY_HEADERS=
# ADR 020 (AWS): share Socket.IO rooms, rate limits and the attendance lock through Redis across tasks.
COORDINATION=
# ElastiCache in-transit encryption.
REDIS_TLS=
# ADR 020 (AWS): verified TLS to RDS; the image ships the CA bundle at this path.
PGSSLMODE=
PGSSLROOTCERT=
# Requests per window per client IP (heartbeats: per user).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REFRESH=30
RATE_LIMIT_PASSWORD_RESET=5
# Desktop agent (ADR 018): redeeming pairing codes and the agent token refresh, per minute.
RATE_LIMIT_AGENT_PAIR=10
RATE_LIMIT_AGENT_TOKEN=30
RATE_LIMIT_HEARTBEAT=10
# How often connected sockets are re-validated as a fallback to LISTEN/NOTIFY.
SOCKET_REVALIDATE_MS=60000

# Breached-password check (FR-AUTH-002): hibp = Have I Been Pwned k-anonymity range API (default),
# local = offline stub blocklist for tests only (refused in production).
BREACHED_PASSWORD_CHECK=hibp
HIBP_API_URL=https://api.pwnedpasswords.com

# Password reset links (FR-AUTH-008) point at the web app.
APP_WEB_URL=http://localhost:3000

# Web app (apps/web). NEXT_PUBLIC_* values are compiled into the browser bundle: never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001
# LiveKit signalling URL the browser may connect to (Content-Security-Policy connect-src). Same as LIVEKIT_URL.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Background jobs (BullMQ on Redis, ADR 007): reminders, carry-over, weekly summary, attendance
# close/reconcile, presence retention, and notification emails. false = no Redis, emails sent inline.
JOBS_ENABLED=true
# With JOBS_ENABLED=false nothing would close dropped sessions (FR-ATT-002). Set a period in ms to run
# the attendance reconciler in-process instead (local development and the browser tests only).
ATTENDANCE_RECONCILE_INLINE_MS=
# A task is due at this local (org timezone) time on its due date; reminders 24 h and 1 h before.
TASK_DUE_TIME=17:00
# Weekly summary email: ISO weekday (1 = Monday ... 5 = Friday) and local time.
WEEKLY_SUMMARY_DAY=5
WEEKLY_SUMMARY_TIME=17:00

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hrvo-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Host the BROWSER uses for presigned upload URLs, if different from S3_ENDPOINT (e.g. behind a proxy).
S3_PUBLIC_ENDPOINT=
# Local/dev only: create the bucket on first use.
S3_CREATE_BUCKET=true
# The web app's CSP must allow the browser to PUT to storage: the browser-facing storage origin.
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000

# Documents (ADR 009). Envelope encryption: each file version has its own key, wrapped by this
# KMS key. Generate locally with `openssl rand -base64 32`. The local KMS is refused in production.
# DOCUMENT_KMS_PROVIDER=aws (staging, production; ADR 021): AWS KMS with two keys (data, recovery).
# Locally you can try it against moto (docker compose service "kms"): DOCUMENT_KMS_ENDPOINT=http://localhost:4566
# and the two key ARNs it returns. The endpoint override is refused in production.
DOCUMENT_KMS_PROVIDER=local
DOCUMENT_KMS_KEY_ID=
DOCUMENT_KMS_RECOVERY_KEY_ID=
DOCUMENT_KMS_ENDPOINT=
DOCUMENT_KMS_LOCAL_KEY=
DOCUMENT_KMS_LOCAL_KEY_ID=local-1
# FR-DOC-006 recovery escrow (SRS 10.1 step 5): a SEPARATE key; only vault.recover uses it.
DOCUMENT_KMS_RECOVERY_KEY=
DOCUMENT_KMS_RECOVERY_KEY_ID=local-recovery-1
# Rate limits per minute for re-authentication / document passwords, and public share links.
RATE_LIMIT_VAULT=20
RATE_LIMIT_SHARE=30
RATE_LIMIT_UNSUBSCRIBE=20
# Allowed upload types (subset of: pdf,docx,xlsx,pptx,png,jpeg,gif,webp,zip,txt).
DOCUMENT_ALLOWED_TYPES=pdf,docx,xlsx,pptx,png,jpeg,gif,webp,zip,txt
# Virus scanning (clamd INSTREAM). Every upload is scanned before it becomes available.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000

# Mailer: smtp = plaintext dev client for Mailhog (refused in production), memory = tests.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hrvo.local

# Default Organization Configuration
DEFAULT_ORG_TIMEZONE=Asia/Colombo
MONITORING_NOTICE_VERSION=v1.0.0

# Media (LiveKit, ADR 016). The browser connects to LIVEKIT_URL; the API calls LIVEKIT_HTTP_URL.
# The dev pair matches infra/livekit/livekit.dev.yaml; production refuses it.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880
LIVEKIT_API_KEY=hrvo-dev
LIVEKIT_API_SECRET=hrvo-dev-secret-change-me-0123456789abcdef # gitleaks:allow (local dev key)
# Meeting recording (FR-MEET-007, ADR 024): where LiveKit Egress uploads the plaintext MP4 before the
# API encrypts it. Locally these fall back to the S3_* values. In production set a dedicated key that
# may only PutObject under <org>/_recordings_staging/ (Terraform creates the IAM user).
RECORDING_S3_ACCESS_KEY= # gitleaks:allow (empty placeholder; the value lives in Secrets Manager)
RECORDING_S3_SECRET_KEY=
# Endpoint as Egress sees it (blank = S3_ENDPOINT; AWS = blank and RECORDING_S3_REGION set).
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=
RECORDING_S3_BUCKET=

# Calendar sync (FR-MEET-006; ADR 023). Register an OAuth app with each provider and set its
# redirect URI to CALENDAR_OAUTH_REDIRECT_URL. Leave a provider empty to switch it off.
CALENDAR_OAUTH_REDIRECT_URL=http://localhost:3001/calendar/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Single-tenant apps put the tenant id here; "common" allows work and personal accounts.
MICROSOFT_OAUTH_TENANT=common


# FR-AUTH-004: set to "off" ONLY for a local demo to let Admin/HR sign in without enrolling 2FA.
# Refused in production. Accounts that already enrolled are still asked for their code.
AUTH_MFA_ENFORCEMENT=
