# Staging TLS proxy (ADR 046). Certificates from Let's Encrypt for the three DNS names, which must
# point at the EC2 Elastic IP before the first start (ports 80 and 443 open).
{
	email {$ACME_EMAIL}
	servers {
		# Only the proxy's own peers are trusted for X-Forwarded-*; clients cannot spoof them.
		trusted_proxies static private_ranges
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}

{$WEB_HOST} {
	import common
	reverse_proxy web:3000
}

# REST and Socket.IO (WebSocket upgrades pass through reverse_proxy).
{$API_HOST} {
	import common
	reverse_proxy api:3001
}

# Presigned document uploads and downloads. The Host header is passed through unchanged, so the
# SigV4 signature the API made for FILES_HOST still matches.
{$FILES_HOST} {
	import common
	reverse_proxy storage:8333
}
