{
  "name": "hrvo-platform",
  "version": "0.1.0",
  "private": true,
  "description": "HR Virtual Office Platform",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/apps/api/test/*.test.js",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage apps/api/test/attendance*.test.ts",
    "demo": "node --experimental-strip-types apps/api/test/demo.ts",
    "demo:shell": "tsc && node dist/apps/api/test/demo-shell.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/websockets": "^12.1.3",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "typescript": "^6.0.3"
  }
