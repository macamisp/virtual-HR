{
  "name": "hrvo-platform",
  "version": "0.1.0",
  "private": true,
  "description": "HR Virtual Office Platform",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "setup": "node scripts/setup.mjs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run lint -w @hrvo/web",
    "test": "tsc && node --test --test-concurrency=4 dist/apps/api/test/*.test.js",
    "test:coverage": "tsc && node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-exclude='**/test/**' --test-coverage-exclude='**/node_modules/**' --test-coverage-exclude='**/*.ts' dist/apps/api/test/*.test.js",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema apps/api/prisma/schema.prisma",
    "db:provision-roles": "node --env-file-if-exists=.env --experimental-strip-types apps/api/prisma/scripts/provision-db-roles.ts",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "demo": "node --experimental-strip-types apps/api/test/demo.ts",
    "demo:shell": "tsc && node dist/apps/api/test/demo-shell.js",
    "api": "tsc && node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "web": "npm run dev -w @hrvo/web",
    "web:build": "npm run build -w @hrvo/web",
    "web:typecheck": "npm run typecheck -w @hrvo/web",
    "e2e": "tsc && npm run e2e -w @hrvo/web",
    "seed:demo": "node --env-file-if-exists=.env --experimental-strip-types apps/api/test/seed-web-demo.ts",
    "seed:demo:internet": "node --env-file-if-exists=.env --experimental-strip-types apps/api/test/seed-internet-demo.ts",
    "demo:internet": "bash scripts/demo-internet.sh",
    "demo:internet:teardown": "bash scripts/demo-internet.sh teardown",
    "test:imds-guard": "bash infra/staging-ec2/test/imds-guard-netns.sh",
    "test:attendance": "tsc && node --test --test-concurrency=4 dist/apps/api/test/attendance-*.test.js dist/apps/api/test/leave-e2e.test.js",
    "e2e:attendance": "tsc && npm run e2e -w @hrvo/web -- 23-accuracy.spec.ts 24-leave.spec.ts",
    "lan:env": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/lan.ts env",
    "lan:certs": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/lan.ts certs",
    "lan:check": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/lan.ts check",
    "lan:share-ca": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/lan.ts share-ca",
    "google:check": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/google-check.ts",
    "lan:up": "bash scripts/lan-https.sh start",
    "lan:down": "bash scripts/lan-https.sh stop"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1144.0",
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "^12.1.3",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "^0.45.1",
    "bullmq": "5.81.5",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.5.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "workspaces": [
    "apps/web",
    "apps/agent",
    "packages/shared"
  ]
}
