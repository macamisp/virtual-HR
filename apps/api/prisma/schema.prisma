/// FR-DOC-014 (ADR 022): a request to sign one PDF version; completed into a new signed version.
model SignatureRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  documentId      String    @map("document_id") @db.Uuid
  sourceVersionId String    @map("source_version_id") @db.Uuid
  sourceSha256    String    @map("source_sha256") @db.Char(64)
  requestedBy     String    @map("requested_by") @db.Uuid
  message         String    @default("") @db.Text
  status          String    @default("OPEN") @db.VarChar(10)
  signedVersionId String?   @map("signed_version_id") @db.Uuid
  signedSha256    String?   @map("signed_sha256") @db.Char(64)
  keyWrapped      Bytes     @map("key_wrapped")
  keyId           String    @map("key_id") @db.VarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  completedAt     DateTime? @map("completed_at") @db.Timestamptz()

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document     Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requester    User              @relation("SignatureRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  signers      SignatureSigner[]

  @@index([orgId, documentId])
  @@map("signature_requests")
}

/// One signer; the evidence of their signature (server time, IP, re-authentication, consent).
model SignatureSigner {
  requestId      String    @map("request_id") @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  orderNo        Int       @map("order_no")
  status         String    @default("PENDING") @db.VarChar(10)
  method         String?   @db.VarChar(4)
  typedName      String?   @map("typed_name") @db.VarChar(100)
  /// Drawn signature (PNG), sealed with the request's data key.
  imageSealed    Bytes?    @map("image_sealed")
  signedAt       DateTime? @map("signed_at") @db.Timestamptz()
  reauthAt       DateTime? @map("reauth_at") @db.Timestamptz()
  consentVersion String?   @map("consent_version") @db.VarChar(20)
  ip             String?   @db.VarChar(45)
  userAgent      String?   @map("user_agent") @db.VarChar(300)
  declineReason  String?   @map("decline_reason") @db.VarChar(500)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  request      SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requestId, userId])
  @@index([orgId, userId])
  @@map("signature_signers")
}

/// FR-MEET-007 (ADR 024): one recording of a meeting. Egress writes the plaintext MP4 to a staging
/// key; the API encrypts it (envelope, KeyProvider purpose "recording") and deletes the staging copy.
model MeetingRecording {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  meetingId       String    @map("meeting_id") @db.Uuid
  startedBy       String    @map("started_by") @db.Uuid
  /// CONSENT, RECORDING, PROCESSING, READY, FAILED, CANCELLED, DELETED
  status          String    @default("CONSENT") @db.VarChar(12)
  /// Everyone in the meeting when recording was requested, plus late joiners who were asked.
  requiredUserIds String[]  @map("required_user_ids") @db.Uuid
  consentDeadline DateTime  @map("consent_deadline") @db.Timestamptz()
  egressId        String?   @unique @map("egress_id") @db.VarChar(64)
  stagingKey      String?   @map("staging_key") @db.Text
  storageKey      String?   @map("storage_key") @db.Text
  dekWrapped      Bytes?    @map("dek_wrapped")
  keyId           String?   @map("key_id") @db.VarChar(100)
  iv              Bytes?
  authTag         Bytes?    @map("auth_tag")
  sha256          String?   @db.Char(64)
  sizeBytes       BigInt?   @map("size_bytes")
  durationSeconds Int?      @map("duration_seconds")
  startedAt       DateTime? @map("started_at") @db.Timestamptz()
  endedAt         DateTime? @map("ended_at") @db.Timestamptz()
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  detail          String?   @db.VarChar(300)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meeting      Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  starter      User               @relation("RecordingStarter", fields: [startedBy], references: [id], onDelete: Cascade)
  consents     RecordingConsent[]

  @@index([orgId, meetingId])
  @@index([status, expiresAt])
  @@map("meeting_recordings")
}

/// FR-MEET-007 / FR-AUD-004: the recorded-consent log. Append-only for the app.
model RecordingConsent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  recordingId   String   @map("recording_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  granted       Boolean
  noticeVersion String   @map("notice_version") @db.VarChar(20)
  at            DateTime @default(now()) @db.Timestamptz()
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(300)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recording    MeetingRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recordingId, userId, at])
  @@map("recording_consents")
}

/// FR-ORG-010 (ADR 027): a leave request for whole days; the manager or HR decides.
model LeaveRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// ANNUAL, SICK, UNPAID, OTHER
  type         String    @db.VarChar(10)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  reason       String    @default("") @db.Text
  /// PENDING, APPROVED, REJECTED, CANCELLED
  status       String    @default("PENDING") @db.VarChar(10)
