  decidedAt    DateTime? @map("decided_at") @db.Timestamptz()
  decisionNote String?   @map("decision_note") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  decider      User?        @relation("LeaveDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([orgId, userId, startDate])
  @@index([orgId, status])
  @@map("leave_requests")
}

/// FR-ORG-011 (ADR 027): the organisation's public holiday calendar (Sri Lanka defaults; HR edits).
model PublicHoliday {
