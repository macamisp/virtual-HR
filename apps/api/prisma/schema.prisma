/// FR-MEET-012 / SRS 7.4 (ADR 017). DMs have dm_key = the two user ids, sorted, so one per pair.
model Channel {
  meetingId String? @unique @map("meeting_id") @db.Uuid
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  kind       String    @db.VarChar(8)
  name       String    @default("") @db.VarChar(60)
  topic      String    @default("") @db.VarChar(250)
  dmKey      String?   @map("dm_key") @db.VarChar(80)
  createdBy  String    @map("created_by") @db.Uuid
  archivedAt DateTime? @map("archived_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      ChannelMember[]
  messages     Message[]

  @@unique([orgId, dmKey])
  @@index([orgId, kind])
  @@map("channels")
}

model ChannelMember {
  orgId      String   @map("org_id") @db.Uuid
  channelId  String   @map("channel_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String   @default("MEMBER") @db.VarChar(8)
  lastReadAt DateTime @default(now()) @map("last_read_at") @db.Timestamptz()
  joinedAt   DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([orgId, userId])
  @@map("channel_members")
}

model Message {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String                   @map("org_id") @db.Uuid
  channelId  String                   @map("channel_id") @db.Uuid
  authorId   String                   @map("author_id") @db.Uuid
  parentId   String?                  @map("parent_id") @db.Uuid
  body       String                   @db.Text
  mentions   String[]                 @default([]) @db.Uuid
  documentId String?                  @map("document_id") @db.Uuid
  editedAt   DateTime?                @map("edited_at") @db.Timestamptz()
  deletedAt  DateTime?                @map("deleted_at") @db.Timestamptz()
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz()
  /// Generated column for FR-MEET-012 search (see the chat migration).
  search     Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig,\nCASE\n    WHEN (deleted_at IS NULL) THEN body\n    ELSE ''::text\nEND)"))

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent       Message?     @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Message[]    @relation("Thread")

  @@index([channelId, createdAt])
  @@index([parentId, createdAt])
  @@index([search], map: "messages_search_idx", type: Gin)
  @@map("messages")
}

/// FR-ATT-011 (ADR 018): a paired desktop agent. Its auth session family is the agent's login;
/// revoking the device revokes the family.
model AgentDevice {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @unique @map("family_id") @db.Uuid
  name         String    @db.VarChar(100)
  platform     String    @db.VarChar(20)
  agentVersion String    @map("agent_version") @db.VarChar(40)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz()
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz()
  revokedBy    String?   @map("revoked_by") @db.Uuid

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@map("agent_devices")
}

/// One-time pairing codes (5 minutes); only the SHA-256 of the code is stored.
