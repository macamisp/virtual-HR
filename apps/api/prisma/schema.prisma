  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz()
  accepted   Int
  rejected   Json     @default("{}")
  sessionIds String[] @default([]) @map("session_ids") @db.Uuid

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, id])
  @@index([orgId, userId])
  @@map("offline_sync_batches")
}

/// FR-ATT-017/018 (ADR 019): items for human review. Never changes recorded time.
model AttendanceFlag {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  sessionId      String?   @map("session_id") @db.Uuid
  workDate       String    @map("work_date") @db.VarChar(10)
  kind           String    @db.VarChar(40)
  category       String    @db.VarChar(20)
  details        Json      @default("{}")
  dedupeKey      String    @map("dedupe_key") @db.VarChar(200)
  status         String    @default("OPEN") @db.VarChar(20)
  resolution     String?   @db.VarChar(20)
  resolutionNote String?   @map("resolution_note") @db.Text
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz()
  userComment    String?   @map("user_comment") @db.Text
  userCommentAt  DateTime? @map("user_comment_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User               @relation("FlagSubject", fields: [userId], references: [id], onDelete: Cascade)
  resolver     User?              @relation("FlagResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  session      AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([orgId, dedupeKey])
  @@index([orgId, status, createdAt])
  @@index([orgId, userId, createdAt])
  @@map("attendance_flags")
}

/// FR-MEET-006 (ADR 023): a person's link to Google Calendar or Outlook. Tokens are encrypted with
/// a data key wrapped by the document key provider (KMS in AWS); never stored in plain text.
model CalendarConnection {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String    @db.VarChar(10)
  accountEmail String?   @map("account_email") @db.VarChar(320)
  tokensEnc    Bytes     @map("tokens_enc")
  keyWrapped   Bytes     @map("key_wrapped")
  keyId        String    @map("key_id") @db.VarChar(100)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz()
  status       String    @default("ACTIVE") @db.VarChar(10)
  lastSyncAt   DateTime? @map("last_sync_at") @db.Timestamptz()
  lastError    String?   @map("last_error") @db.VarChar(300)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, provider])
  @@map("calendar_connections")
}

/// OAuth `state` (hashed) with the PKCE verifier; single use, 10 minutes.
model CalendarOauthState {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
