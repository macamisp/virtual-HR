datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations run as the schema owner; the app connects as non-owner hrvo_app (RLS enforced).
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                          String                 @db.VarChar(200)
  slug                          String                 @unique @db.VarChar(80)
  timezone                      String                 @default("Asia/Colombo") @db.VarChar(64)
  /// FR-TASK-007: hours before an unaccepted task is escalated.
  taskAcceptanceEscalationHours Int                    @default(24) @map("task_acceptance_escalation_hours")
  createdAt                     DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  users                         User[]
  teams                         Team[]
  workSchedules                 WorkSchedule[]
  attendanceSessions            AttendanceSession[]
  attendanceSegments            AttendanceSegment[]
  heartbeatNonces               HeartbeatNonce[]
  deviceSequences               DeviceSequence[]
  sessionSecrets                SessionSecret[]
  attendanceCorrections         AttendanceCorrection[]
  attendanceDaily               AttendanceDaily[]
  draftTimesheets               DraftTimesheet[]
  presenceEvents                PresenceEvent[]
  auditLogs                     AuditLog[]
  monitoringConsents            MonitoringConsent[]
  invitations                   Invitation[]
  authSessions                  AuthSession[]
  passwordResetTokens           PasswordResetToken[]
  projects                      Project[]
  projectMembers                ProjectMember[]
  tasks                         Task[]
  taskChecklistItems            TaskChecklistItem[]
  taskComments                  TaskComment[]
  taskAttachments               TaskAttachment[]
  taskActivity                  TaskActivity[]
  dailyPlans                    DailyPlan[]
  dailyPlanItems                DailyPlanItem[]
  weeklyPlans                   WeeklyPlan[]
  taskSavedViews                TaskSavedView[]

  @@map("organizations")
}

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  email               String    @db.VarChar(255)
  displayName         String?   @map("display_name") @db.VarChar(100)
  role                String    @default("EMPLOYEE") @db.VarChar(50)
  teamId              String?   @map("team_id") @db.Uuid
  managerId           String?   @map("manager_id") @db.Uuid
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecret           String?   @map("mfa_secret") @db.VarChar(255)
  mfaRecoveryCodes    String[]  @default([]) @map("mfa_recovery_codes")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz()
  status              String    @default("ACTIVE") @db.VarChar(20)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team         Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  manager      User?        @relation("UserSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates User[]       @relation("UserSubordinates")
  ledTeams     Team[]       @relation("TeamLead")

  attendanceSessions    AttendanceSession[]
  heartbeatNonces       HeartbeatNonce[]
  deviceSequences       DeviceSequence[]
  attendanceCorrections AttendanceCorrection[] @relation("UserCorrections")
  reviewedCorrections   AttendanceCorrection[] @relation("ReviewerCorrections")
  attendanceDaily       AttendanceDaily[]
  draftTimesheets       DraftTimesheet[]
  presenceEvents        PresenceEvent[]
  auditLogs             AuditLog[]
  monitoringConsents    MonitoringConsent[]
  invitationsSent       Invitation[]           @relation("InvitedByUser")
  authSessions          AuthSession[]
  workSchedules         WorkSchedule[]
  passwordResetTokens   PasswordResetToken[]
  managedProjects       Project[]              @relation("ProjectManager")
  projectMemberships    ProjectMember[]
  assignedTasks         Task[]                 @relation("TaskAssignee")
  reportedTasks         Task[]                 @relation("TaskReporter")
  taskComments          TaskComment[]
  taskAttachments       TaskAttachment[]
  taskActivity          TaskActivity[]
  dailyPlans            DailyPlan[]
  weeklyPlans           WeeklyPlan[]
  taskSavedViews        TaskSavedView[]

  @@map("users")
}

model Team {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String   @db.VarChar(100)
  leadId    String?  @map("lead_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead          User?          @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members       User[]         @relation("TeamMembers")
  workSchedules WorkSchedule[]
  invitations   Invitation[]

  @@map("teams")
}

model WorkSchedule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  teamId        String?   @map("team_id") @db.Uuid
  days          Json
  flexible      Boolean   @default(false)
  graceMinutes  Int       @default(10) @map("grace_minutes")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("work_schedules")
}

model AttendanceSession {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                  String    @map("org_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  deviceId               String    @map("device_id") @db.VarChar(100)
  workDate               String    @map("work_date") @db.VarChar(10)
  clockInAt              DateTime  @map("clock_in_at") @db.Timestamptz()
  clockOutAt             DateTime? @map("clock_out_at") @db.Timestamptz()
  clockInSource          String    @map("clock_in_source") @db.VarChar(40)
  clockOutSource         String?   @map("clock_out_source") @db.VarChar(40)
  activeSeconds          Int       @default(0) @map("active_seconds")
  idleSeconds            Int       @default(0) @map("idle_seconds")
  breakSeconds           Int       @default(0) @map("break_seconds")
  meetingSeconds         Int       @default(0) @map("meeting_seconds")
  netSeconds             Int       @default(0) @map("net_seconds")
  lastHeartbeatAt        DateTime  @map("last_heartbeat_at") @db.Timestamptz()
  ipIn                   String    @map("ip_in") @db.VarChar(45)
  ipOut                  String?   @map("ip_out") @db.VarChar(45)
  flags                  String[]  @default([])
  status                 String    @default("OPEN") @db.VarChar(20)
  currentState           String    @default("ACTIVE") @map("current_state") @db.VarChar(20)
  previousState          String?   @map("previous_state") @db.VarChar(20)
  graceTimerExpiresAt    DateTime? @map("grace_timer_expires_at") @db.Timestamptz()
  consecutiveIdleSeconds Int       @default(0) @map("consecutive_idle_seconds")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization   Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  segments       AttendanceSegment[]
  corrections    AttendanceCorrection[]
  presenceEvents PresenceEvent[]

  @@map("attendance_sessions")
}

model AttendanceSegment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  state           String    @db.VarChar(20)
  startedAt       DateTime  @map("started_at") @db.Timestamptz()
  endedAt         DateTime? @map("ended_at") @db.Timestamptz()
  durationSeconds Int       @default(0) @map("duration_seconds")
  meetingId       String?   @map("meeting_id") @db.VarChar(100)
  flags           String[]  @default([])
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("attendance_segments")
}

model HeartbeatNonce {
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  nonce     String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId, nonce])
  @@map("heartbeat_nonces")
}

model DeviceSequence {
  orgId        String   @map("org_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  deviceId     String   @map("device_id") @db.VarChar(100)
  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId, deviceId])
  @@map("device_sequences")
}

model SessionSecret {
  sessionId String   @id @map("session_id") @db.VarChar(128)
  orgId     String   @map("org_id") @db.Uuid
  secret    String   @db.VarChar(256)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("session_secrets")
}

model AttendanceCorrection {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  sessionId          String?   @map("session_id") @db.Uuid
  requestedIn        DateTime  @map("requested_in") @db.Timestamptz()
  requestedOut       DateTime  @map("requested_out") @db.Timestamptz()
  reason             String    @db.Text
  evidenceDocumentId String?   @map("evidence_document_id") @db.Uuid
  status             String    @default("PENDING") @db.VarChar(20)
  reviewerId         String?   @map("reviewer_id") @db.Uuid
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewNote         String?   @map("review_note") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User               @relation("UserCorrections", fields: [userId], references: [id], onDelete: Cascade)
  reviewer     User?              @relation("ReviewerCorrections", fields: [reviewerId], references: [id], onDelete: SetNull)
  session      AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@map("attendance_corrections")
}

model AttendanceDaily {
  orgId             String    @map("org_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  workDate          String    @map("work_date") @db.VarChar(10)
  firstIn           DateTime? @map("first_in") @db.Timestamptz()
  lastOut           DateTime? @map("last_out") @db.Timestamptz()
  activeSeconds     Int       @default(0) @map("active_seconds")
  idleSeconds       Int       @default(0) @map("idle_seconds")
  breakSeconds      Int       @default(0) @map("break_seconds")
  meetingSeconds    Int       @default(0) @map("meeting_seconds")
  netSeconds        Int       @default(0) @map("net_seconds")
  expectedSeconds   Int       @default(0) @map("expected_seconds")
  lateMinutes       Int       @default(0) @map("late_minutes")
  earlyLeaveMinutes Int       @default(0) @map("early_leave_minutes")
  overtimeMinutes   Int       @default(0) @map("overtime_minutes")
  dayStatus         String    @default("PRESENT") @map("day_status") @db.VarChar(20)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId, workDate])
  @@map("attendance_daily")
}

model DraftTimesheet {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  workDate          String   @map("work_date") @db.VarChar(10)
  periodStart       DateTime @map("period_start") @db.Date
  periodEnd         DateTime @map("period_end") @db.Date
  status            String   @default("DRAFT") @db.VarChar(20)
  attendanceMinutes Int      @default(0) @map("attendance_minutes")
  loggedMinutes     Int      @default(0) @map("logged_minutes")
  billableMinutes   Int      @default(0) @map("billable_minutes")
  varianceMinutes   Int      @default(0) @map("variance_minutes")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, workDate])
  @@map("draft_timesheets")
}

model PresenceEvent {
  id        BigInt    @id @default(autoincrement())
  orgId     String    @map("org_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  sessionId String?   @map("session_id") @db.Uuid
  serverTs  DateTime  @map("server_ts") @db.Timestamptz()
  clientTs  DateTime? @map("client_ts") @db.Timestamptz()
  eventType String    @map("event_type") @db.VarChar(50)
  state     String    @db.VarChar(20)
  seq       BigInt    @default(0)
  ip        String?   @db.VarChar(45)
  meta      Json?     @default("{}")

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("presence_events")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  orgId      String   @map("org_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  prevHash   String   @map("prev_hash") @db.VarChar(64)
  hash       String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model MonitoringConsent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  noticeVersion String   @map("notice_version") @db.VarChar(50)
  acceptedAt    DateTime @map("accepted_at") @db.Timestamptz()
  ip            String?  @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("monitoring_consents")
}

model Invitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  email      String    @db.VarChar(255)
  role       String    @default("EMPLOYEE") @db.VarChar(50)
  teamId     String?   @map("team_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(128)
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  inviter      User         @relation("InvitedByUser", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model AuthSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  familyId         String   @map("family_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(128)
  isRevoked        Boolean  @default(false) @map("is_revoked")
  // ROTATED (normal refresh), LOGOUT, FAMILY_REUSE, PASSWORD_RESET, USER_DEACTIVATED
  revokedReason    String?  @map("revoked_reason") @db.VarChar(40)
  ip               String?  @db.VarChar(45)
  userAgent        String?  @map("user_agent") @db.Text
  expiresAt        DateTime @map("expires_at") @db.Timestamptz()
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([refreshTokenHash])
  @@index([orgId, familyId])
  @@index([orgId, userId])
  @@map("auth_sessions")
}

// FR-AUTH-008: single-use password reset link, valid 30 minutes. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz()
  usedAt      DateTime? @map("used_at") @db.Timestamptz()
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@map("password_reset_tokens")
}

// ==================== Tasks (SRS 5.7, 7.4) ====================

model Project {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  name       String    @db.VarChar(200)
  code       String    @db.VarChar(30)
  clientName String?   @map("client_name") @db.VarChar(200)
  managerId  String?   @map("manager_id") @db.Uuid
  billable   Boolean   @default(false)
  status     String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, ON_HOLD, DONE, ARCHIVED
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager      User?           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  tasks        Task[]

  @@unique([orgId, code])
  @@map("projects")
}

model ProjectMember {
  orgId     String   @map("org_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([orgId, userId])
  @@map("project_members")
}

model Task {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String    @map("org_id") @db.Uuid
  projectId             String?   @map("project_id") @db.Uuid
  parentTaskId          String?   @map("parent_task_id") @db.Uuid
  title                 String    @db.VarChar(300)
  /// Markdown; rendered and sanitised in the browser (marked + DOMPurify).
  description           String    @default("") @db.Text
  status                String    @default("TODO") @db.VarChar(20)
  priority              String    @default("MEDIUM") @db.VarChar(10)
  assigneeId            String?   @map("assignee_id") @db.Uuid
  reporterId            String    @map("reporter_id") @db.Uuid
  acceptanceStatus      String    @default("NOT_REQUIRED") @map("acceptance_status") @db.VarChar(20)
  acceptanceRequestedAt DateTime? @map("acceptance_requested_at") @db.Timestamptz()
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz()
  declinedAt            DateTime? @map("declined_at") @db.Timestamptz()
  declineReason         String?   @map("decline_reason") @db.Text
  escalatedAt           DateTime? @map("escalated_at") @db.Timestamptz()
  dueDate               DateTime? @map("due_date") @db.Date
  plannedDate           DateTime? @map("planned_date") @db.Date
  estimateMinutes       Int?      @map("estimate_minutes")
  actualMinutes         Int?      @map("actual_minutes")
  labels                String[]  @default([])
  recurrenceRule        String?   @map("recurrence_rule") @db.Text
  completedAt           DateTime? @map("completed_at") @db.Timestamptz()
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz()

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent       Task?               @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]              @relation("Subtasks")
  assignee     User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter     User                @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  checklist    TaskChecklistItem[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  activity     TaskActivity[]
  planItems    DailyPlanItem[]

  @@index([orgId, assigneeId, status])
  @@index([orgId, reporterId])
  @@index([orgId, projectId])
  @@index([orgId, dueDate])
  @@index([orgId, plannedDate])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskChecklistItem {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  text      String    @db.VarChar(300)
  done      Boolean   @default(false)
  sortOrder Int       @default(0) @map("sort_order")
  doneAt    DateTime? @map("done_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskComment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  taskId           String    @map("task_id") @db.Uuid
  authorId         String    @map("author_id") @db.Uuid
  body             String    @db.Text
  mentionedUserIds String[]  @default([]) @map("mentioned_user_ids") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

/// References only until the Documents module stores files (FR-DOC).
model TaskAttachment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  name      String    @db.VarChar(255)
  url       String    @db.Text
  mimeType  String?   @map("mime_type") @db.VarChar(100)
  sizeBytes BigInt?   @map("size_bytes")
  addedBy   String    @map("added_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [addedBy], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

/// Append-only history of every change (FR-TASK-002, 006).
model TaskActivity {
  id        BigInt   @id @default(autoincrement())
  orgId     String   @map("org_id") @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  type      String   @db.VarChar(40)
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_activity")
}

// ==================== Planning (SRS 7.4 daily_plans, daily_plan_items, weekly_plans) ====================

/// Start-of-day plan and end-of-day report per user (FR-TASK-003).
model DailyPlan {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  planDate     DateTime  @map("plan_date") @db.Date
  goals        String    @default("") @db.Text
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz()
  eodSummary   String?   @map("eod_summary") @db.Text
  blockers     String?   @db.Text
  tomorrowPlan String?   @map("tomorrow_plan") @db.Text
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        DailyPlanItem[]

  @@unique([userId, planDate])
  @@index([orgId, planDate])
  @@map("daily_plans")
}

model DailyPlanItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  planId        String    @map("plan_id") @db.Uuid
  taskId        String    @map("task_id") @db.Uuid
  sortOrder     Int       @default(0) @map("sort_order")
  status        String    @default("PLANNED") @db.VarChar(20) // PLANNED, DONE, CARRIED_OVER
  carriedToDate DateTime? @map("carried_to_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan         DailyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([planId, taskId])
  @@index([taskId])
  @@map("daily_plan_items")
}

/// Weekly goals and capacity (FR-TASK-004). Goals: [{ id, text, done }].
model WeeklyPlan {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  weekStart       DateTime  @map("week_start") @db.Date
  goals           Json      @default("[]")
  capacityMinutes Int?      @map("capacity_minutes")
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("weekly_plans")
}

/// Saved task list filters per user (FR-TASK-005).
model TaskSavedView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(60)
  filters   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("task_saved_views")
}
