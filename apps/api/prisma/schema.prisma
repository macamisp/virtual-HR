datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations run as the schema owner; the app connects as non-owner hrvo_app (RLS enforced).
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                          String                     @db.VarChar(200)
  slug                          String                     @unique @db.VarChar(80)
  timezone                      String                     @default("Asia/Colombo") @db.VarChar(64)
  /// FR-TASK-007: hours before an unaccepted task is escalated.
  taskAcceptanceEscalationHours Int                        @default(24) @map("task_acceptance_escalation_hours")
  /// FR-TS-002: WEEKLY, BIWEEKLY or MONTHLY; bi-weekly blocks count from the anchor Monday.
  timesheetPeriod               String                     @default("WEEKLY") @map("timesheet_period") @db.VarChar(10)
  timesheetPeriodAnchor         DateTime                   @default(dbgenerated("'2026-01-05'::date")) @map("timesheet_period_anchor") @db.Date
  /// FR-TS-004 / SRS 6.4: manual time per day before entries are flagged (0..480).
  manualTimeLimitMinutes        Int                        @default(120) @map("manual_time_limit_minutes")
  /// FR-TS-005 / SRS 6.4: variance alert threshold in percent (5..50).
  timesheetVariancePct          Int                        @default(15) @map("timesheet_variance_pct")
  /// FR-TS-012: days after the period end by which a timesheet should be submitted.
  timesheetSubmitDueDays        Int                        @default(1) @map("timesheet_submit_due_days")
  /// FR-DOC-005 / SRS 6.4: minutes a re-authentication opens the vault (1..60).
  vaultReauthMinutes            Int                        @default(10) @map("vault_reauth_minutes")
  attMissedHeartbeatSeconds     Int                        @default(90) @map("att_missed_heartbeat_seconds")
  attDisconnectGraceSeconds     Int                        @default(120) @map("att_disconnect_grace_seconds")
  attIdleSeconds                Int                        @default(300) @map("att_idle_seconds")
  attPauseSeconds               Int                        @default(900) @map("att_pause_seconds")
  attMaxSessionSeconds          Int                        @default(50400) @map("att_max_session_seconds")
  attPaidBreakMinutes           Int                        @default(60) @map("att_paid_break_minutes")
  retentionPresenceDays         Int                        @default(90) @map("retention_presence_days")
  retentionNotificationsDays    Int                        @default(365) @map("retention_notifications_days")
  /// FR-MEET-007 / SRS 13: meeting recording is off unless the organisation turns it on.
  recordingEnabled              Boolean                    @default(false) @map("recording_enabled")
  /// FR-ADM-004 / SRS 13: recordings are kept 90 days by default (7..3650).
  retentionRecordingsDays       Int                        @default(90) @map("retention_recordings_days")
  createdAt                     DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  users                         User[]
  teams                         Team[]
  workSchedules                 WorkSchedule[]
  attendanceSessions            AttendanceSession[]
  attendanceSegments            AttendanceSegment[]
  heartbeatNonces               HeartbeatNonce[]
  deviceSequences               DeviceSequence[]
  sessionSecrets                SessionSecret[]
  attendanceCorrections         AttendanceCorrection[]
  attendanceDaily               AttendanceDaily[]
  draftTimesheets               DraftTimesheet[]
  presenceEvents                PresenceEvent[]
  auditLogs                     AuditLog[]
  monitoringConsents            MonitoringConsent[]
  invitations                   Invitation[]
  authSessions                  AuthSession[]
  passwordResetTokens           PasswordResetToken[]
  projects                      Project[]
  projectMembers                ProjectMember[]
  tasks                         Task[]
  taskChecklistItems            TaskChecklistItem[]
  taskComments                  TaskComment[]
  taskAttachments               TaskAttachment[]
  taskActivity                  TaskActivity[]
  dailyPlans                    DailyPlan[]
  dailyPlanItems                DailyPlanItem[]
  weeklyPlans                   WeeklyPlan[]
  taskSavedViews                TaskSavedView[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  jobRuns                       JobRun[]
  subcontractorProfiles         SubcontractorProfile[]
  timesheets                    Timesheet[]
  timesheetDays                 TimesheetDay[]
  timeEntries                   TimeEntry[]
  timesheetApprovals            TimesheetApproval[]
  documentFolders               DocumentFolder[]
  documents                     Document[]
  documentVersions              DocumentVersion[]
  documentAcl                   DocumentAcl[]
  documentAccessLogs            DocumentAccessLog[]
  contracts                     Contract[]
  vaultReauth                   VaultReauth[]
  documentPasswordAttempts      DocumentPasswordAttempt[]
  documentShareLinks            DocumentShareLink[]
  documentRetentionRules        DocumentRetentionRule[]
  orgRoles                      OrgRole[]
  requiredDocumentCategories    RequiredDocumentCategory[]
  privacyRequests               PrivacyRequest[]
  offices                       Office[]
  rooms                         Room[]
  roomInvites                   RoomInvite[]
  desks                         Desk[]
  meetings                      Meeting[]
  meetingAttendees              MeetingAttendee[]
  meetingParticipants           MeetingParticipant[]
  meetingLobby                  MeetingLobby[]
  meetingActionItems            MeetingActionItem[]
  meetingCalls                  MeetingCall[]
  channels                      Channel[]
  channelMembers                ChannelMember[]
  messages                      Message[]
  attAllowedCidrs               String[]                   @default([]) @map("att_allowed_cidrs")
  attAllowedCountries           String[]                   @default([]) @map("att_allowed_countries")
  attPresenceChallenge          Boolean                    @default(false) @map("att_presence_challenge")
  attLongIdleAlertMinutes       Int                        @default(0) @map("att_long_idle_alert_minutes")
  attFlagAlertThreshold         Int                        @default(3) @map("att_flag_alert_threshold")
  attNoClockInReminder          Boolean                    @default(true) @map("att_no_clockin_reminder")

  agentDevices       AgentDevice[]
  agentPairingCodes  AgentPairingCode[]
  offlineSyncBatches OfflineSyncBatch[]

  attendanceFlags AttendanceFlag[]

  calendarConnections CalendarConnection[]
  calendarOauthStates CalendarOauthState[]
  calendarEventLinks  CalendarEventLink[]
  calendarBusy        CalendarBusy[]

  signatureRequests SignatureRequest[]
  signatureSigners  SignatureSigner[]
  meetingRecordings MeetingRecording[]
  recordingConsents RecordingConsent[]
  leaveRequests     LeaveRequest[]
  publicHolidays    PublicHoliday[]

  @@map("organizations")
}

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  email               String    @db.VarChar(255)
  displayName         String?   @map("display_name") @db.VarChar(100)
  role                String    @default("EMPLOYEE") @db.VarChar(50)
  teamId              String?   @map("team_id") @db.Uuid
  managerId           String?   @map("manager_id") @db.Uuid
  customRoleId        String?   @map("custom_role_id") @db.Uuid
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecret           String?   @map("mfa_secret") @db.VarChar(255)
  mfaRecoveryCodes    String[]  @default([]) @map("mfa_recovery_codes")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz()
  status              String    @default("ACTIVE") @db.VarChar(20)
  /// FR-NOTIF-004: IANA zone for quiet hours and reports; null = the organisation's zone.
  timezone            String?   @db.VarChar(64)
  /// FR-NOTIF-004: minutes after local midnight; both null = no quiet hours.
  quietHoursStart     Int?      @map("quiet_hours_start") @db.SmallInt
  quietHoursEnd       Int?      @map("quiet_hours_end") @db.SmallInt
  /// FR-AUD-003: set when the person's data was anonymised; the row stays as a pseudonymous key.
  anonymisedAt        DateTime? @map("anonymised_at") @db.Timestamptz()
  /// FR-VO-003: AUTO (attendance decides), AWAY or DND, and an optional message.
  voStatus            String    @default("AUTO") @map("vo_status") @db.VarChar(8)
  voStatusMessage     String    @default("") @map("vo_status_message") @db.VarChar(100)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastCountry         String?   @map("last_country") @db.VarChar(2)
  lastCountryAt       DateTime? @map("last_country_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team         Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  manager      User?        @relation("UserSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  customRole   OrgRole?     @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  subordinates User[]       @relation("UserSubordinates")
  ledTeams     Team[]       @relation("TeamLead")

  attendanceSessions      AttendanceSession[]
  heartbeatNonces         HeartbeatNonce[]
  deviceSequences         DeviceSequence[]
  attendanceCorrections   AttendanceCorrection[]   @relation("UserCorrections")
  reviewedCorrections     AttendanceCorrection[]   @relation("ReviewerCorrections")
  attendanceDaily         AttendanceDaily[]
  draftTimesheets         DraftTimesheet[]
  presenceEvents          PresenceEvent[]
  auditLogs               AuditLog[]
  monitoringConsents      MonitoringConsent[]
  invitationsSent         Invitation[]             @relation("InvitedByUser")
  authSessions            AuthSession[]
  workSchedules           WorkSchedule[]
  passwordResetTokens     PasswordResetToken[]
  managedProjects         Project[]                @relation("ProjectManager")
  projectMemberships      ProjectMember[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  reportedTasks           Task[]                   @relation("TaskReporter")
  taskComments            TaskComment[]
  taskAttachments         TaskAttachment[]
  taskActivity            TaskActivity[]
  dailyPlans              DailyPlan[]
  weeklyPlans             WeeklyPlan[]
  taskSavedViews          TaskSavedView[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  privacySubjectOf        PrivacyRequest[]         @relation("PrivacySubject")
  privacyRequested        PrivacyRequest[]         @relation("PrivacyRequester")
  rateProfile             SubcontractorProfile?
  timesheets              Timesheet[]
  timesheetDays           TimesheetDay[]
  timeEntries             TimeEntry[]
  timesheetApprovals      TimesheetApproval[]
  ownedDocuments          Document[]               @relation("DocumentOwner")
  linkedDocuments         Document[]               @relation("DocumentLinkedUser")
  uploadedVersions        DocumentVersion[]        @relation("DocumentVersionUploader")
  contracts               Contract[]               @relation("UserContracts")
  roomInvites             RoomInvite[]
  desk                    Desk?
  callsMade               MeetingCall[] @relation("CallCaller")
  callsReceived           MeetingCall[] @relation("CallCallee")
  hostedMeetings          Meeting[]                @relation("MeetingHost")
  meetingAttendance       MeetingAttendee[]
  meetingSessions         MeetingParticipant[]
  meetingLobbyEntries     MeetingLobby[]
  channelMemberships      ChannelMember[]
  messages                Message[]

  agentDevices       AgentDevice[]
  agentPairingCodes  AgentPairingCode[]
  offlineSyncBatches OfflineSyncBatch[]

  attendanceFlags AttendanceFlag[] @relation("FlagSubject")
  resolvedFlags   AttendanceFlag[] @relation("FlagResolver")

  calendarConnections CalendarConnection[]
  calendarOauthStates CalendarOauthState[]
  calendarEventLinks  CalendarEventLink[]
  calendarBusy        CalendarBusy[]

  signatureRequests SignatureRequest[] @relation("SignatureRequester")
  signatureSigners  SignatureSigner[]
  meetingRecordings MeetingRecording[] @relation("RecordingStarter")
  recordingConsents RecordingConsent[]
  leaveRequests     LeaveRequest[]     @relation("LeaveRequester")
  leaveDecisions    LeaveRequest[]     @relation("LeaveDecider")
  holidaysCreated   PublicHoliday[]

  @@map("users")
}

model Team {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String   @db.VarChar(100)
  leadId    String?  @map("lead_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead          User?          @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members       User[]         @relation("TeamMembers")
  workSchedules WorkSchedule[]
  invitations   Invitation[]

  @@map("teams")
}

model WorkSchedule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  teamId        String?   @map("team_id") @db.Uuid
  days          Json
  flexible      Boolean   @default(false)
  graceMinutes  Int       @default(10) @map("grace_minutes")
  earlyLeaveGraceMinutes Int? @map("early_leave_grace_minutes")
  breakAllowanceMinutes  Int? @map("break_allowance_minutes")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("work_schedules")
}

model AttendanceSession {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                  String    @map("org_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  deviceId               String    @map("device_id") @db.VarChar(100)
  workDate               String    @map("work_date") @db.VarChar(10)
  clockInAt              DateTime  @map("clock_in_at") @db.Timestamptz()
  clockOutAt             DateTime? @map("clock_out_at") @db.Timestamptz()
  clockInSource          String    @map("clock_in_source") @db.VarChar(40)
  clockOutSource         String?   @map("clock_out_source") @db.VarChar(40)
  activeSeconds          Int       @default(0) @map("active_seconds")
  idleSeconds            Int       @default(0) @map("idle_seconds")
  breakSeconds           Int       @default(0) @map("break_seconds")
  meetingSeconds         Int       @default(0) @map("meeting_seconds")
  netSeconds             Int       @default(0) @map("net_seconds")
  lastHeartbeatAt        DateTime  @map("last_heartbeat_at") @db.Timestamptz()
  ipIn                   String    @map("ip_in") @db.VarChar(45)
  ipOut                  String?   @map("ip_out") @db.VarChar(45)
  flags                  String[]  @default([])
  status                 String    @default("OPEN") @db.VarChar(20)
  currentState           String    @default("ACTIVE") @map("current_state") @db.VarChar(20)
  previousState          String?   @map("previous_state") @db.VarChar(20)
  graceTimerExpiresAt    DateTime? @map("grace_timer_expires_at") @db.Timestamptz()
  consecutiveIdleSeconds Int       @default(0) @map("consecutive_idle_seconds")
  /// ADR 018: the desktop agent leading this session's counters.
  agentDeviceId          String?   @map("agent_device_id") @db.VarChar(100)
  agentLastSeenAt        DateTime? @map("agent_last_seen_at") @db.Timestamptz()
  webInCallAt            DateTime? @map("web_in_call_at") @db.Timestamptz()
  /// FR-ATT-018: coarse location (country) where the session started and last reported.
  countryIn              String?   @map("country_in") @db.VarChar(2)
  countryOut             String?   @map("country_out") @db.VarChar(2)
  /// FR-ATT-023: an open "Are you still working?" question.
  challengeId            String?   @map("challenge_id") @db.Uuid
  challengeIssuedAt      DateTime? @map("challenge_issued_at") @db.Timestamptz()
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization   Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  segments       AttendanceSegment[]
  corrections    AttendanceCorrection[]
  reviewFlags    AttendanceFlag[]
  presenceEvents PresenceEvent[]

  @@map("attendance_sessions")
}

model AttendanceSegment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  state           String    @db.VarChar(20)
  startedAt       DateTime  @map("started_at") @db.Timestamptz()
  endedAt         DateTime? @map("ended_at") @db.Timestamptz()
  durationSeconds Int       @default(0) @map("duration_seconds")
  meetingId       String?   @map("meeting_id") @db.VarChar(100)
  flags           String[]  @default([])
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("attendance_segments")
}

model HeartbeatNonce {
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  nonce     String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId, nonce])
  @@map("heartbeat_nonces")
}

model DeviceSequence {
  orgId        String   @map("org_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  deviceId     String   @map("device_id") @db.VarChar(100)
  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId, deviceId])
  @@map("device_sequences")
}

model SessionSecret {
  sessionId String   @id @map("session_id") @db.VarChar(128)
  orgId     String   @map("org_id") @db.Uuid
  secret    String   @db.VarChar(256)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  /// ADR 025: when this login last sent a valid heartbeat (decides whether another login keeps a person clocked in).
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("session_secrets")
}

model AttendanceCorrection {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  sessionId          String?   @map("session_id") @db.Uuid
  requestedIn        DateTime  @map("requested_in") @db.Timestamptz()
  requestedOut       DateTime  @map("requested_out") @db.Timestamptz()
  reason             String    @db.Text
  evidenceDocumentId String?   @map("evidence_document_id") @db.Uuid
  status             String    @default("PENDING") @db.VarChar(20)
  reviewerId         String?   @map("reviewer_id") @db.Uuid
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewNote         String?   @map("review_note") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User               @relation("UserCorrections", fields: [userId], references: [id], onDelete: Cascade)
  reviewer     User?              @relation("ReviewerCorrections", fields: [reviewerId], references: [id], onDelete: SetNull)
  session      AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@map("attendance_corrections")
}

model AttendanceDaily {
  orgId             String    @map("org_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  workDate          String    @map("work_date") @db.VarChar(10)
  firstIn           DateTime? @map("first_in") @db.Timestamptz()
  lastOut           DateTime? @map("last_out") @db.Timestamptz()
  activeSeconds     Int       @default(0) @map("active_seconds")
  idleSeconds       Int       @default(0) @map("idle_seconds")
  breakSeconds      Int       @default(0) @map("break_seconds")
  meetingSeconds    Int       @default(0) @map("meeting_seconds")
  netSeconds        Int       @default(0) @map("net_seconds")
  expectedSeconds   Int       @default(0) @map("expected_seconds")
  lateMinutes       Int       @default(0) @map("late_minutes")
  earlyLeaveMinutes Int       @default(0) @map("early_leave_minutes")
  overtimeMinutes   Int       @default(0) @map("overtime_minutes")
  excessBreakMinutes Int      @default(0) @map("excess_break_minutes")
  dayStatus         String    @default("PRESENT") @map("day_status") @db.VarChar(20)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId, workDate])
  @@map("attendance_daily")
}

/// Deprecated: merged into timesheets + timesheet_days (ADR 008). Kept read-only until the merge is verified, then dropped.
model DraftTimesheet {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  workDate          String   @map("work_date") @db.VarChar(10)
  periodStart       DateTime @map("period_start") @db.Date
  periodEnd         DateTime @map("period_end") @db.Date
  status            String   @default("DRAFT") @db.VarChar(20)
  attendanceMinutes Int      @default(0) @map("attendance_minutes")
  loggedMinutes     Int      @default(0) @map("logged_minutes")
  billableMinutes   Int      @default(0) @map("billable_minutes")
  varianceMinutes   Int      @default(0) @map("variance_minutes")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, workDate])
  @@map("draft_timesheets_legacy")
}

model PresenceEvent {
  id        BigInt    @id @default(autoincrement())
  orgId     String    @map("org_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  sessionId String?   @map("session_id") @db.Uuid
  serverTs  DateTime  @map("server_ts") @db.Timestamptz()
  clientTs  DateTime? @map("client_ts") @db.Timestamptz()
  eventType String    @map("event_type") @db.VarChar(50)
  state     String    @db.VarChar(20)
  seq       BigInt    @default(0)
  ip        String?   @db.VarChar(45)
  meta      Json?     @default("{}")

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("presence_events")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  orgId      String   @map("org_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  prevHash   String   @map("prev_hash") @db.VarChar(64)
  hash       String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model MonitoringConsent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  noticeVersion String   @map("notice_version") @db.VarChar(50)
  consentType   String   @default("MONITORING") @map("consent_type") @db.VarChar(20)
  granted       Boolean  @default(true)
  acceptedAt    DateTime @map("accepted_at") @db.Timestamptz()
  ip            String?  @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("monitoring_consents")
}

model Invitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  email      String    @db.VarChar(255)
  role       String    @default("EMPLOYEE") @db.VarChar(50)
  teamId     String?   @map("team_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(128)
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  inviter      User         @relation("InvitedByUser", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model AuthSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  familyId         String   @map("family_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(128)
  isRevoked        Boolean  @default(false) @map("is_revoked")
  // ROTATED (normal refresh), LOGOUT, FAMILY_REUSE, PASSWORD_RESET, USER_DEACTIVATED
  revokedReason    String?  @map("revoked_reason") @db.VarChar(40)
  ip               String?  @db.VarChar(45)
  userAgent        String?  @map("user_agent") @db.Text
  expiresAt        DateTime @map("expires_at") @db.Timestamptz()
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([refreshTokenHash])
  @@index([orgId, familyId])
  @@index([orgId, userId])
  @@map("auth_sessions")
}

// FR-AUTH-008: single-use password reset link, valid 30 minutes. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz()
  usedAt      DateTime? @map("used_at") @db.Timestamptz()
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@map("password_reset_tokens")
}

// ==================== Tasks (SRS 5.7, 7.4) ====================

model Project {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  name       String    @db.VarChar(200)
  code       String    @db.VarChar(30)
  clientName String?   @map("client_name") @db.VarChar(200)
  managerId  String?   @map("manager_id") @db.Uuid
  billable   Boolean   @default(false)
  status     String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, ON_HOLD, DONE, ARCHIVED
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager      User?           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  tasks        Task[]
  timeEntries  TimeEntry[]
  documents    Document[]

  @@unique([orgId, code])
  @@map("projects")
}

model ProjectMember {
  orgId        String   @map("org_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  addedBy      String?  @map("added_by") @db.Uuid
  /// FR-ORG-004 / FR-TS-009: project-specific rate for this member (in the profile's rate type and currency).
  rateOverride Decimal? @map("rate_override") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([orgId, userId])
  @@map("project_members")
}

model Task {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String    @map("org_id") @db.Uuid
  projectId             String?   @map("project_id") @db.Uuid
  parentTaskId          String?   @map("parent_task_id") @db.Uuid
  title                 String    @db.VarChar(300)
  /// Markdown; rendered and sanitised in the browser (marked + DOMPurify).
  description           String    @default("") @db.Text
  status                String    @default("TODO") @db.VarChar(20)
  priority              String    @default("MEDIUM") @db.VarChar(10)
  assigneeId            String?   @map("assignee_id") @db.Uuid
  reporterId            String    @map("reporter_id") @db.Uuid
  acceptanceStatus      String    @default("NOT_REQUIRED") @map("acceptance_status") @db.VarChar(20)
  acceptanceRequestedAt DateTime? @map("acceptance_requested_at") @db.Timestamptz()
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz()
  declinedAt            DateTime? @map("declined_at") @db.Timestamptz()
  declineReason         String?   @map("decline_reason") @db.Text
  escalatedAt           DateTime? @map("escalated_at") @db.Timestamptz()
  dueDate               DateTime? @map("due_date") @db.Date
  plannedDate           DateTime? @map("planned_date") @db.Date
  estimateMinutes       Int?      @map("estimate_minutes")
  actualMinutes         Int?      @map("actual_minutes")
  labels                String[]  @default([])
  recurrenceRule        String?   @map("recurrence_rule") @db.Text
  completedAt           DateTime? @map("completed_at") @db.Timestamptz()
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz()

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent       Task?               @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]              @relation("Subtasks")
  assignee     User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter     User                @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  checklist    TaskChecklistItem[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  activity     TaskActivity[]
  timeEntries  TimeEntry[]
  planItems    DailyPlanItem[]

  @@index([orgId, assigneeId, status])
  @@index([orgId, reporterId])
  @@index([orgId, projectId])
  @@index([orgId, dueDate])
  @@index([orgId, plannedDate])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskChecklistItem {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  text      String    @db.VarChar(300)
  done      Boolean   @default(false)
  sortOrder Int       @default(0) @map("sort_order")
  doneAt    DateTime? @map("done_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskComment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  taskId           String    @map("task_id") @db.Uuid
  authorId         String    @map("author_id") @db.Uuid
  body             String    @db.Text
  mentionedUserIds String[]  @default([]) @map("mentioned_user_ids") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

/// References only until the Documents module stores files (FR-DOC).
model TaskAttachment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  name      String    @db.VarChar(255)
  url       String    @db.Text
  mimeType  String?   @map("mime_type") @db.VarChar(100)
  sizeBytes BigInt?   @map("size_bytes")
  addedBy   String    @map("added_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [addedBy], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

/// Append-only history of every change (FR-TASK-002, 006).
model TaskActivity {
  id        BigInt   @id @default(autoincrement())
  orgId     String   @map("org_id") @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  type      String   @db.VarChar(40)
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_activity")
}

// ==================== Planning (SRS 7.4 daily_plans, daily_plan_items, weekly_plans) ====================

/// Start-of-day plan and end-of-day report per user (FR-TASK-003).
model DailyPlan {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  planDate     DateTime  @map("plan_date") @db.Date
  goals        String    @default("") @db.Text
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz()
  eodSummary   String?   @map("eod_summary") @db.Text
  blockers     String?   @db.Text
  tomorrowPlan String?   @map("tomorrow_plan") @db.Text
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        DailyPlanItem[]

  @@unique([userId, planDate])
  @@index([orgId, planDate])
  @@map("daily_plans")
}

model DailyPlanItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  planId        String    @map("plan_id") @db.Uuid
  taskId        String    @map("task_id") @db.Uuid
  sortOrder     Int       @default(0) @map("sort_order")
  status        String    @default("PLANNED") @db.VarChar(20) // PLANNED, DONE, CARRIED_OVER
  carriedToDate DateTime? @map("carried_to_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan         DailyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([planId, taskId])
  @@index([taskId])
  @@map("daily_plan_items")
}

/// Weekly goals and capacity (FR-TASK-004). Goals: [{ id, text, done }].
model WeeklyPlan {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  weekStart       DateTime  @map("week_start") @db.Date
  goals           Json      @default("[]")
  capacityMinutes Int?      @map("capacity_minutes")
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("weekly_plans")
}

/// Saved task list filters per user (FR-TASK-005).
model TaskSavedView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(60)
  filters   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("task_saved_views")
}

// ==================== Notifications (FR-NOTIF-001, FR-TASK-011, 016) ====================

/// In-app notification; email delivery is tracked in emailed_at. dedupe_key makes scheduled
/// reminders idempotent (one per user and key).
model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(40)
  title      String    @db.VarChar(200)
  body       String    @default("") @db.Text
  link       String?   @db.VarChar(500)
  entityType String?   @map("entity_type") @db.VarChar(40)
  entityId   String?   @map("entity_id") @db.Uuid
  dedupeKey  String?   @map("dedupe_key") @db.VarChar(200)
  sendEmail  Boolean   @default(false) @map("send_email")
  /// FR-NOTIF-004: false = email only; hidden from the notification centre.
  inApp      Boolean   @default(true) @map("in_app")
  readAt     DateTime? @map("read_at") @db.Timestamptz()
  emailedAt  DateTime? @map("emailed_at") @db.Timestamptz()
  /// FR-NOTIF-004: not before this instant (quiet hours); null = at once.
  emailAfter DateTime? @map("email_after") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([orgId, emailAfter])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// FR-NOTIF-004: per user and event type; a missing row means both channels on.
model NotificationPreference {
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(40)
  inApp     Boolean  @default(true) @map("in_app")
  email     Boolean  @default(true)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@index([orgId])
  @@map("notification_preferences")
}

/// FR-REP-005: document categories a role must have on file (compliance report).
model RequiredDocumentCategory {
  orgId    String @map("org_id") @db.Uuid
  role     String @db.VarChar(50)
  category String @db.VarChar(20)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, role, category])
  @@map("required_document_categories")
}

/// FR-AUD-002/003: the documented workflow of exports and anonymisations.
model PrivacyRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  subjectUserId String    @map("subject_user_id") @db.Uuid
  type          String    @db.VarChar(12)
  status        String    @default("PENDING") @db.VarChar(12)
  requestedBy   String    @map("requested_by") @db.Uuid
  reason        String    @default("") @db.Text
  blockers      Json      @default("[]")
  result        Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  completedAt   DateTime? @map("completed_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subject      User         @relation("PrivacySubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  requester    User         @relation("PrivacyRequester", fields: [requestedBy], references: [id], onDelete: Cascade)

  @@index([orgId, subjectUserId])
  @@map("privacy_requests")
}

/// Once-per-period markers for scheduled jobs (daily close, retention, weekly summary).
model JobRun {
  orgId     String   @map("org_id") @db.Uuid
  job       String   @db.VarChar(60)
  runKey    String   @map("run_key") @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, job, runKey])
  @@map("job_runs")
}

/// FR-ORG-002 rate fields (FR-TS-009). Tax ID and bank details (encrypted) arrive with the ORG slice.
model SubcontractorProfile {
  userId             String   @id @map("user_id") @db.Uuid
  orgId              String   @map("org_id") @db.Uuid
  rateType           String   @map("rate_type") @db.VarChar(10)
  rate               Decimal  @db.Decimal(12, 2)
  currency           String   @db.Char(3)
  overtimeMultiplier Decimal  @default(1.50) @map("overtime_multiplier") @db.Decimal(4, 2)
  weeklyHoursCap     Decimal? @map("weekly_hours_cap") @db.Decimal(5, 2)
  updatedBy          String?  @map("updated_by") @db.Uuid
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("subcontractor_profiles")
}

/// FR-TS-002 / FR-TS-006: periodic, approvable timesheet per user.
model Timesheet {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  periodStart       DateTime  @map("period_start") @db.Date
  periodEnd         DateTime  @map("period_end") @db.Date
  status            String    @default("DRAFT") @db.VarChar(12)
  attendanceMinutes Int       @default(0) @map("attendance_minutes")
  loggedMinutes     Int       @default(0) @map("logged_minutes")
  billableMinutes   Int       @default(0) @map("billable_minutes")
  varianceMinutes   Int       @default(0) @map("variance_minutes")
  flaggedDays       Int       @default(0) @map("flagged_days")
  amount            Decimal?  @db.Decimal(14, 2)
  currency          String?   @db.Char(3)
  /// Payable breakdown stored at approval (FR-TS-009): rate type, lines per project.
  payable           Json?
  notes             String    @default("") @db.Text
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz()
  approvedBy        String?   @map("approved_by") @db.Uuid
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz()
  rejectedBy        String?   @map("rejected_by") @db.Uuid
  rejectedAt        DateTime? @map("rejected_at") @db.Timestamptz()
  rejectionReason   String?   @map("rejection_reason") @db.Text
  reopenedBy        String?   @map("reopened_by") @db.Uuid
  reopenedAt        DateTime? @map("reopened_at") @db.Timestamptz()
  reopenReason      String?   @map("reopen_reason") @db.Text
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  days         TimesheetDay[]
  entries      TimeEntry[]
  approvals    TimesheetApproval[]

  @@unique([orgId, userId, periodStart])
  @@index([orgId, status])
  @@index([orgId, periodStart])
  @@map("timesheets")
}

/// FR-TS-001 / FR-TS-005: the daily draft: attendance vs logged time and its variance.
model TimesheetDay {
  orgId             String    @map("org_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  workDate          DateTime  @map("work_date") @db.Date
  timesheetId       String    @map("timesheet_id") @db.Uuid
  attendanceMinutes Int       @default(0) @map("attendance_minutes")
  loggedMinutes     Int       @default(0) @map("logged_minutes")
  manualMinutes     Int       @default(0) @map("manual_minutes")
  varianceMinutes   Int       @default(0) @map("variance_minutes")
  variancePct       Int?      @map("variance_pct")
  flags             String[]  @default([])
  alertedAt         DateTime? @map("alerted_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  timesheet    Timesheet    @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@id([orgId, userId, workDate])
  @@index([timesheetId])
  @@map("timesheet_days")
}

/// FR-TS-003 / FR-TS-004: raw task-level time (timer or manual).
model TimeEntry {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  timesheetId  String    @map("timesheet_id") @db.Uuid
  projectId    String?   @map("project_id") @db.Uuid
  taskId       String?   @map("task_id") @db.Uuid
  workDate     DateTime  @map("work_date") @db.Date
  startedAt    DateTime? @map("started_at") @db.Timestamptz()
  endedAt      DateTime? @map("ended_at") @db.Timestamptz()
  minutes      Int       @default(0)
  source       String    @db.VarChar(24)
  billable     Boolean   @default(true)
  note         String    @default("") @db.Text
  manualReason String?   @map("manual_reason") @db.Text
  flagged      Boolean   @default(false)
  flagReason   String?   @map("flag_reason") @db.VarChar(40)
  autoStopped  Boolean   @default(false) @map("auto_stopped")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  timesheet    Timesheet    @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([orgId, userId, workDate])
  @@index([timesheetId])
  @@index([taskId])
  @@map("time_entries")
}

/// FR-TS-006 / FR-TS-011 / FR-TS-013: append-only approval history (turnaround reports).
model TimesheetApproval {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  timesheetId String   @map("timesheet_id") @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  action      String   @db.VarChar(10)
  comment     String   @default("") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  timesheet    Timesheet    @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([timesheetId, createdAt])
  @@map("timesheet_approvals")
}

/// FR-DOC-002: folder tree; access can be granted per folder (inherited by its contents).
model DocumentFolder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(120)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     DocumentFolder[] @relation("FolderTree")
  documents    Document[]
  acl          DocumentAcl[]

  @@index([orgId, parentId])
  @@map("document_folders")
}

/// SRS 7.4 contracts (minimal, for linking contract documents; FR-ORG-003 alerts come with the ORG slice).
model Contract {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  title             String    @db.VarChar(200)
  scope             String    @default("") @db.Text
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  status            String    @default("DRAFT") @db.VarChar(12)
  documentId        String?   @unique @map("document_id") @db.Uuid
  renewalNoticeDays Int       @default(30) @map("renewal_notice_days")
  createdBy         String?   @map("created_by") @db.Uuid
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User         @relation("UserContracts", fields: [userId], references: [id], onDelete: Cascade)
  document        Document?    @relation("ContractDocument", fields: [documentId], references: [id], onDelete: SetNull)
  linkedDocuments Document[]   @relation("DocumentLinkedContract")

  @@index([orgId, userId])
  @@map("contracts")
}

/// FR-DOC-002/003: document metadata; content lives in object storage, encrypted per version.
model Document {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  folderId          String?   @map("folder_id") @db.Uuid
  title             String?   @db.VarChar(300)
  category          String    @db.VarChar(20)
  confidentiality   String    @default("NORMAL") @db.VarChar(20)
  ownerId           String    @map("owner_id") @db.Uuid
  linkedUserId      String?   @map("linked_user_id") @db.Uuid
  linkedContractId  String?   @map("linked_contract_id") @db.Uuid
  linkedProjectId   String?   @map("linked_project_id") @db.Uuid
  tags              String[]  @default([])
  expiresAt         DateTime? @map("expires_at") @db.Date
  passwordProtected Boolean   @default(false) @map("password_protected")
  currentVersionId  String?   @unique @map("current_version_id") @db.Uuid
  legalHold         Boolean   @default(false) @map("legal_hold")
  /// FR-DOC-007: titles of CONFIDENTIAL/RESTRICTED documents, sealed with a per-document metadata key.
  titleEnc          Bytes?    @map("title_enc")
  metaKeyWrapped    Bytes?    @map("meta_key_wrapped")
  metaKeyId         String?   @map("meta_key_id") @db.VarChar(100)
  legalHoldReason   String?   @map("legal_hold_reason") @db.Text
  legalHoldBy       String?   @map("legal_hold_by") @db.Uuid
  legalHoldAt       DateTime? @map("legal_hold_at") @db.Timestamptz()
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy         String?   @map("deleted_by") @db.Uuid
  /// FR-DOC-017: keys destroyed; content unrecoverable.
  shreddedAt        DateTime? @map("shredded_at") @db.Timestamptz()
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization     Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folder           DocumentFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  owner            User                      @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  linkedUser       User?                     @relation("DocumentLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  linkedContract   Contract?                 @relation("DocumentLinkedContract", fields: [linkedContractId], references: [id], onDelete: SetNull)
  linkedProject    Project?                  @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)
  currentVersion   DocumentVersion?          @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[]         @relation("DocumentVersions")
  acl              DocumentAcl[]
  contracts        Contract[]                @relation("ContractDocument")
  shareLinks       DocumentShareLink[]
  passwordAttempts DocumentPasswordAttempt[]

  signatureRequests SignatureRequest[]

  @@index([orgId, folderId])
  @@index([orgId, ownerId])
  @@index([orgId, linkedUserId])
  @@index([orgId, expiresAt])
  @@map("documents")
}

/// FR-DOC-004/007/013: one stored version with its own wrapped data key and scan status.
model DocumentVersion {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  documentId         String    @map("document_id") @db.Uuid
  versionNo          Int       @map("version_no")
  storageKey         String?   @map("storage_key") @db.Text
  stagingKey         String?   @map("staging_key") @db.Text
  uploadId           String?   @map("upload_id") @db.Text
  fileNameEnc        Bytes?    @map("file_name_enc")
  mimeType           String?   @map("mime_type") @db.VarChar(120)
  sizeBytes          BigInt?   @map("size_bytes")
  declaredSize       BigInt    @map("declared_size")
  sha256             String?   @db.Char(64)
  dekWrappedKms      Bytes?    @map("dek_wrapped_kms")
  kmsKeyId           String    @map("kms_key_id") @db.VarChar(100)
  iv                 Bytes?
  authTag            Bytes?    @map("auth_tag")
  dekWrappedPw       Bytes?    @map("dek_wrapped_pw")
  pwSalt             Bytes?    @map("pw_salt")
  pwKdfParams        Json?     @map("pw_kdf_params")
  /// SRS 10.1 step 5: escrow for password recovery, under the separate recovery key.
  dekWrappedRecovery Bytes?    @map("dek_wrapped_recovery")
  recoveryKeyId      String?   @map("recovery_key_id") @db.VarChar(100)
  scanStatus         String    @default("UPLOADING") @map("scan_status") @db.VarChar(12)
  scanDetail         String?   @map("scan_detail") @db.VarChar(300)
  restoredFromId     String?   @map("restored_from_id") @db.Uuid
  uploadedBy         String    @map("uploaded_by") @db.Uuid
  uploadedAt         DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz()
  completedAt        DateTime? @map("completed_at") @db.Timestamptz()
  scannedAt          DateTime? @map("scanned_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document     Document     @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor   Document?    @relation("DocumentCurrentVersion")
  uploader     User         @relation("DocumentVersionUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNo])
  @@index([orgId, scanStatus])
  @@map("document_versions")
}

/// FR-DOC-009: VIEW / DOWNLOAD / EDIT / MANAGE for a user, role or team, on a document or a folder.
model DocumentAcl {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  documentId    String?   @map("document_id") @db.Uuid
  folderId      String?   @map("folder_id") @db.Uuid
  principalType String    @map("principal_type") @db.VarChar(8)
  principalId   String?   @map("principal_id") @db.Uuid
  principalRole String?   @map("principal_role") @db.VarChar(50)
  permission    String    @db.VarChar(10)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz()
  grantedBy     String    @map("granted_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document     Document?       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folder       DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([folderId])
  @@map("document_acl")
}

/// FR-DOC-012: immutable access trail. No FK on document/user so rows never change.
model DocumentAccessLog {
  id         BigInt   @id @default(autoincrement())
  orgId      String   @map("org_id") @db.Uuid
  documentId String?  @map("document_id") @db.Uuid
  versionId  String?  @map("version_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(16)
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(400)
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, documentId, createdAt])
  @@index([orgId, userId, createdAt])
  @@map("document_access_logs")
}

/// FR-DOC-005: last re-authentication per login (session family; access tokens rotate).
model VaultReauth {
  familyId          String   @id @map("family_id") @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  reauthenticatedAt DateTime @map("reauthenticated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@map("vault_reauth")
}

/// FR-DOC-006: wrong document passwords per user and document, with a temporary lockout.
model DocumentPasswordAttempt {
  orgId       String    @map("org_id") @db.Uuid
  documentId  String    @map("document_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@map("document_password_attempts")
}

/// FR-DOC-010: time-limited external links. Only the token's SHA-256 is stored.
model DocumentShareLink {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  passwordHash   String?   @map("password_hash") @db.Text
  viewOnly       Boolean   @default(false) @map("view_only")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz()
  maxDownloads   Int?      @map("max_downloads")
  downloadCount  Int       @default(0) @map("download_count")
  failedAttempts Int       @default(0) @map("failed_attempts")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz()
  revokedBy      String?   @map("revoked_by") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([orgId, documentId])
  @@map("document_share_links")
}

/// FR-DOC-017: per-category retention (minimum keep, optional automatic shredding).
model DocumentRetentionRule {
  orgId          String   @map("org_id") @db.Uuid
  category       String   @db.VarChar(20)
  minYears       Int?     @map("min_years")
  autoShredYears Int?     @map("auto_shred_years")
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, category])
  @@map("document_retention_rules")
}

/// FR-ADM-002: a custom role = a built-in base role (which keeps its scope rules) plus/minus permissions.
model OrgRole {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String   @map("org_id") @db.Uuid
  name               String   @db.VarChar(80)
  description        String   @default("") @db.Text
  baseRole           String   @map("base_role") @db.VarChar(50)
  addedPermissions   String[] @default([]) @map("added_permissions")
  removedPermissions String[] @default([]) @map("removed_permissions")
  createdBy          String?  @map("created_by") @db.Uuid
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([orgId, name])
  @@map("org_roles")
}

/// FR-VO-001 / SRS 7.4: one office per organisation (for now), floors in map_json.
model Office {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @unique @map("org_id") @db.Uuid
  name            String   @db.VarChar(100)
  mapJson         Json     @map("map_json")
  /// FR-VO-005: px within which people form a proximity group.
  proximityRadius Int      @default(96) @map("proximity_radius")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rooms        Room[]
  desks        Desk[]

  @@map("offices")
}

/// FR-VO-004 / SRS 7.4. Synchronised from the map's "rooms" layer; access settings are kept.
model Room {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  officeId        String   @map("office_id") @db.Uuid
  floorId         String   @map("floor_id") @db.VarChar(32)
  mapObjectId     Int      @map("map_object_id")
  name            String   @db.VarChar(80)
  type            String   @db.VarChar(12)
  capacity        Int
  bounds          Json
  accessMode      String   @default("OPEN") @map("access_mode") @db.VarChar(10)
  passwordHash    String?  @map("password_hash") @db.Text
  livekitRoomName String   @map("livekit_room_name") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  office       Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  invites      RoomInvite[]
  meetings     Meeting[]

  @@unique([officeId, floorId, mapObjectId])
  @@index([orgId])
  @@map("rooms")
}

model RoomInvite {
  orgId     String   @map("org_id") @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  invitedBy String?  @map("invited_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([orgId])
  @@map("room_invites")
}

/// FR-VO-007: personal desks, synchronised from the map's "desks" layer.
model Desk {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  officeId       String   @map("office_id") @db.Uuid
  floorId        String   @map("floor_id") @db.VarChar(32)
  mapObjectId    Int      @map("map_object_id")
  label          String   @db.VarChar(80)
  bounds         Json
  assignedUserId String?  @unique @map("assigned_user_id") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  office       Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  assignee     User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@unique([officeId, floorId, mapObjectId])
  @@index([orgId])
  @@map("desks")
}

/// FR-MEET-001..003, 009 / SRS 7.4: instant, room and scheduled meetings (ADR 016).
model Meeting {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  type            String    @db.VarChar(10)
  status          String    @default("SCHEDULED") @db.VarChar(10)
  title           String    @db.VarChar(200)
  agenda          String    @default("") @db.Text
  notes           String    @default("") @db.Text
  hostId          String    @map("host_id") @db.Uuid
  roomId          String?   @map("room_id") @db.Uuid
  scheduledStart  DateTime? @map("scheduled_start") @db.Timestamptz()
  scheduledEnd    DateTime? @map("scheduled_end") @db.Timestamptz()
  startedAt       DateTime? @map("started_at") @db.Timestamptz()
  endedAt         DateTime? @map("ended_at") @db.Timestamptz()
  recurrenceRule  String?   @map("recurrence_rule") @db.Text
  recordingId     String?   @map("recording_id") @db.Uuid
  lobby           Boolean   @default(true)
  livekitRoomName String    @map("livekit_room_name") @db.VarChar(120)
  icsSequence     Int       @default(0) @map("ics_sequence")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  host         User                 @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Cascade)
  room         Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  attendees    MeetingAttendee[]
  participants MeetingParticipant[]
  lobbyEntries MeetingLobby[]
  actionItems  MeetingActionItem[]

  calendarEventLinks CalendarEventLink[]
  recordings         MeetingRecording[]
  calls              MeetingCall[]
  chat               Channel?

  @@unique([livekitRoomName])
  @@index([orgId, status])
  @@index([orgId, scheduledStart])
  @@map("meetings")
}

model MeetingAttendee {
  orgId     String   @map("org_id") @db.Uuid
  meetingId String   @map("meeting_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("ATTENDEE") @db.VarChar(10)
  response  String   @default("NEEDS_ACTION") @db.VarChar(12)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([orgId, userId])
  @@map("meeting_attendees")
}

/// FR-MEET-009: one row per join; times are the API server's clock when LiveKit reports the event.
model MeetingParticipant {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  meetingId       String    @map("meeting_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  livekitSid      String    @map("livekit_sid") @db.VarChar(64)
  joinedAt        DateTime  @map("joined_at") @db.Timestamptz()
  leftAt          DateTime? @map("left_at") @db.Timestamptz()
  durationSeconds Int       @default(0) @map("duration_seconds")

