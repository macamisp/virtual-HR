# HRVO staging on one EC2 host (ADR 046; docs/runbooks/staging-ec2.md). Placeholders only.
# On the server: cp .env.staging.example .env.staging && chmod 600 .env.staging, then fill in.
# Generate random values with: openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48
# The API runs with NODE_ENV=production; it refuses to start when a required value is missing or
# is a development default. Values set by docker-compose.staging.yml itself (database host, TLS,
# Redis/S3/ClamAV hosts, CORS, public URLs, KMS provider) are not repeated here.

# ---- Addresses the browser uses ----
# SSH mode (docker-compose.staging.ssh.yml; no DNS, proxy or Elastic IP). The tunnel's local ports
# must be these same numbers.
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
FILES_URL=http://localhost:8333
# Public mode (Caddy + Let's Encrypt; DNS names pointing at the instance, ports 80/443 open):
# WEB_URL=https://app.staging.example.com
# API_URL=https://api.staging.example.com
# FILES_URL=https://files.staging.example.com
# ACME_EMAIL=ops@example.com
# Where docker/staging/db-tls.sh wrote the database certificates.
DB_TLS_DIR=/opt/virtual-hr/secrets/db-tls

# ---- Sessions ----
# At least 32 random characters, unique to staging. Also signs unsubscribe links.
JWT_SECRET=CHANGE_ME
# Leave unset: the refresh cookie stays SameSite=Strict (web and API share the parent domain).
# REFRESH_COOKIE_SAMESITE=

# ---- PostgreSQL application roles (passwords set by the migrate job) ----
PGPASSWORD=CHANGE_ME
PGRETENTION_PASSWORD=CHANGE_ME

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME

# ---- Object storage (SeaweedFS on this host) ----
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=hrvo-documents
S3_REGION=us-east-1
S3_CREATE_BUCKET=true

# ---- Document encryption: AWS KMS (two keys, ADR 021). Credentials come from the instance role. ----
AWS_REGION=eu-west-1
DOCUMENT_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT_ID:key/DOCUMENTS_KEY_ID
DOCUMENT_KMS_RECOVERY_KEY_ID=arn:aws:kms:REGION:ACCOUNT_ID:key/RECOVERY_KEY_ID

# ---- LiveKit Cloud (also compiled into the web build as NEXT_PUBLIC_LIVEKIT_URL) ----
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=CHANGE_ME
# At least 32 characters (production check).
LIVEKIT_API_SECRET=CHANGE_ME
# Webhook (public mode only; LiveKit Cloud cannot reach an SSH tunnel): API_URL/media/livekit/webhook

# ---- E-mail (required: the API does not start without a working transport) ----
# Option A: authenticated SMTP submission (ADR 046), e.g. Gmail with an App Password (16 letters,
# no spaces). Production accepts it only with a login, port 587, STARTTLS and a certificate the
# system trust store accepts for SMTP_HOST, and a plain sender address (no display name).
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=sender@example.com
# Option B: Resend with a sending domain verified in Resend (display names allowed here).
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=CHANGE_ME
# MAIL_FROM=HR Virtual Office <no-reply@staging.example.com>

# ---- Google sign-in (FR-AUTH-005). Redirect URI is set by the compose file: ----
# API_URL/auth/google/callback, e.g. http://localhost:3001/auth/google/callback in SSH mode
# (Google allows http://localhost redirect URIs). Add it to the OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Calendar sync (optional): API_URL/calendar/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Sign-up protection ----
# Leave empty for the Have I Been Pwned range API (k-anonymity); "local" is refused in production.
BREACHED_PASSWORD_CHECK=
# CAPTCHA_PROVIDER=turnstile
# CAPTCHA_SECRET=CHANGE_ME

# ---- Meeting recordings (optional, off by default). LiveKit Cloud egress must reach the bucket. ----
# RECORDING_S3_ENDPOINT=https://files.staging.example.com  (public mode only)
# RECORDING_S3_BUCKET=hrvo-recordings
# RECORDING_S3_REGION=us-east-1
# RECORDING_S3_FORCE_PATH_STYLE=true
# RECORDING_S3_ACCESS_KEY=CHANGE_ME
# RECORDING_S3_SECRET_KEY=CHANGE_ME
