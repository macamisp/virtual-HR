# Supabase PostgreSQL connection for the EC2 stack (ADR 052). Placeholders only — never commit values.
# On the server: cp .env.staging.supabase.example .env.staging.supabase && chmod 600 .env.staging.supabase
# Dashboard → Connect → "Session pooler" shows the host and the user format <role>.<project-ref>.

# Session pooler host, e.g. aws-0-ap-southeast-1.pooler.supabase.com (port 5432 is fixed in the compose file)
SUPABASE_PGHOST=CHANGE_ME
# Migration/owner login: the project's postgres role through the pooler, i.e. postgres.<project-ref>
SUPABASE_ADMIN_USER=CHANGE_ME
# The database password chosen when the project was created (Dashboard → Database → Reset password)
SUPABASE_ADMIN_PASSWORD=CHANGE_ME
# Runtime logins created by the init migration, through the pooler: hrvo_app.<project-ref>, hrvo_retention.<project-ref>
SUPABASE_APP_USER=CHANGE_ME
SUPABASE_RETENTION_USER=CHANGE_ME
# New random passwords for those roles (set by the migrate job), e.g. `openssl rand -hex 32`
SUPABASE_APP_PASSWORD=CHANGE_ME
SUPABASE_RETENTION_PASSWORD=CHANGE_ME
# Host path of Supabase's CA certificate (Dashboard → Database → SSL configuration → Download certificate)
SUPABASE_CA_FILE=/opt/virtual-hr/secrets/supabase/prod-ca-2021.crt
# Optional: per-process pool sizes (session pooler; keep the API's total under the project's pool size).
# Worst case = LIMIT + 3 x POOL_MAX + 1 sessions per role (ADR 052): 3 and 2 give 10 of Supavisor's 15.
SUPABASE_PRISMA_CONNECTION_LIMIT=3
SUPABASE_PG_POOL_MAX=2
