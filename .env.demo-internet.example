# Internet demo overrides (docs/runbooks/demo-internet.md). Copy to .env.demo-internet (gitignored),
# fill in, then load with:  set -a; . ./.env.demo-internet; set +a
# Exported variables take precedence over the API's --env-file=.env, so nothing in .env changes.
# Never commit the filled-in file: it holds the LiveKit secret and the JWT secret.

# Public addresses (https only). Named tunnel: your three hostnames. Quick tunnel: the printed URLs.
APP_WEB_URL=https://app.demo.example.com
CORS_ORIGINS=https://app.demo.example.com
NEXT_PUBLIC_API_URL=https://api.demo.example.com
NEXT_PUBLIC_STORAGE_URL=https://files.demo.example.com
S3_PUBLIC_ENDPOINT=https://files.demo.example.com
# The tunnel (cloudflared on this machine) is the only proxy in front of the API.
TRUST_PROXY=loopback
# Leave empty unless port 3001 is firewalled so that only the tunnel can reach it (runbook, step 3).
TRUST_PROXY_HEADERS=

# LiveKit Cloud project (Settings > Keys). The browser and the API use the same project.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_HTTP_URL=https://YOUR-PROJECT.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Secrets for this demo only: generate fresh ones (openssl rand -hex 32 / -hex 24).
JWT_SECRET=
# Keep 2FA enforced and the real breached-password check (leave these empty).
AUTH_MFA_ENFORCEMENT=
BREACHED_PASSWORD_CHECK=
