# Copy to production.tfvars (not committed). No secrets here: they live in Secrets Manager.
aws_account_id     = "000000000000"
domain             = "hrvo.example.com"
cloudflare_zone_id = "<zone id>"
alert_emails       = ["ops@example.com"]
image_tag          = "<git sha>"
livekit_url        = "wss://<project>.livekit.cloud"
# ADR 024: true once the organisation wants meeting recording (then create the IAM key, see the runbook).
recording_enabled  = false
