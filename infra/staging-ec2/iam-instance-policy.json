{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocumentKeysWithContextOnly",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:Decrypt"],
      "Resource": [
        "arn:aws:kms:REGION:ACCOUNT_ID:key/DOCUMENTS_KEY_ID",
        "arn:aws:kms:REGION:ACCOUNT_ID:key/RECOVERY_KEY_ID"
      ],
      "Condition": {
        "Null": {
          "kms:EncryptionContext:org_id": "false",
          "kms:EncryptionContext:document_id": "false"
        }
      }
    }
  ]
}
