# HRVO self-hosted LiveKit settings (ADR 067). Copy to livekit.env on the media host. NOT secret:
# secrets live in secrets.env (./configure.sh init-secrets).

# Both names: Cloudflare DNS records of type A, "DNS only" (grey cloud), pointing at the media
# host's Elastic IP. A proxied (orange) record breaks WebRTC media and TURN.
LIVEKIT_DOMAIN=livekit.virtual-hr.site
TURN_DOMAIN=livekit-turn.virtual-hr.site

# Where LiveKit posts room, participant and recording events (HRVO API, signed with the key pair).
WEBHOOK_URL=https://api.virtual-hr.site/media/livekit/webhook

# Let's Encrypt (TLS_ISSUER=internal only for local rehearsals). Both required with acme:
#   ACME_EMAIL  the account e-mail (certificate expiry notices)
#   ACME_CA     staging first (untrusted test certificates, generous rate limits; check.py needs
#               --cafile with Let's Encrypt's staging roots), then production. No default.
TLS_ISSUER=acme
ACME_EMAIL=
ACME_CA=staging

# The group every LiveKit container runs with; the host table inet hrvo_livekit (livekit-guard.sh)
# drops its packets to the EC2 instance metadata service. A number no host account or group uses.
LIVEKIT_GID=64900

# The instance's public IP (an Elastic IP survives stop/start; an auto-assigned one does not).
# Empty = discover it with STUN (use_external_ip); pinning it avoids a wrong guess.
NODE_IP=

# Ports (defaults follow LiveKit's VM guide). Public: 80, 443/tcp, 7881/tcp, 3478/udp,
# 50000-60000/udp. Loopback only (also enforced by livekit-guard.sh): LIVEKIT_PORT, REDIS_PORT, TURN_TLS_PORT.
LIVEKIT_PORT=7880
REDIS_PORT=6389
CADDY_TLS_PORT=443
RTC_TCP_PORT=7881
RTC_PORT_RANGE_START=50000
RTC_PORT_RANGE_END=60000
TURN_TLS_PORT=5349
TURN_UDP_PORT=3478
# true = Caddy terminates TURN/TLS on 443 (production). false needs TURN_CERT_FILE/TURN_KEY_FILE.
TURN_EXTERNAL_TLS=true

# Guard rails (see docs/runbooks/livekit-selfhost.md, "Sizing").
ROOM_MAX_PARTICIPANTS=100
LIMIT_NUM_TRACKS=-1
LIMIT_BYTES_PER_SEC=1000000000
